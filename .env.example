# Copy to .env.local for local overrides. All values are read at build time.

# Absolute production origin, no trailing slash. Used for canonical URLs,
# Open Graph, JSON-LD and the sitemap. On Vercel, if unset, the build falls
# back to https://$VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
SITE_URL=https://www.example.com

# "true" lets search engines index the site (robots meta + robots.txt).
# Anything else keeps the site noindex and disallowed. Turn it on only after
# the business owner approves launch, and only with SITE_URL set to the real
# domain (the build fails if indexing is on while the URL is localhost).
SITE_INDEXABLE=false
